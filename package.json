{
  "name": "delivery-metrics",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cloudnonic/delivery-metrics-api dev",
    "dev:web": "pnpm --filter @cloudnonic/delivery-metrics-web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "sync": "pnpm --filter @cloudnonic/delivery-metrics-api sync",
    "hash-password": "pnpm --filter @cloudnonic/delivery-metrics-api hash-password"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
