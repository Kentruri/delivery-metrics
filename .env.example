NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Postgres; docker compose up db gives postgres://metrics:metrics@localhost:5432/metrics
DATABASE_URL=

# Sign-in: one shared password, stored as a hash (pnpm hash-password), and a random secret of 32+ characters
APP_PASSWORD_HASH=
SESSION_SECRET=

# Bearer key the daily GitHub Action sends to POST /v1/sync (32+ characters)
SYNC_API_KEY=

# First day of the history
HISTORY_SINCE=2026-01-01

# Tensorparc sources. GitHub is required; a host left empty is skipped and its deploys come from GitHub merges.
TP_GITHUB_TOKEN=
TP_NETLIFY_TOKEN=
# "production=<site id>,staging=<site id>,develop=<site id>", or one site id for every branch
TP_NETLIFY_SITES=
# Forge token with the scopes organization:view and server:view; the organization slug and the
# ids of the servers whose sites run belture-api, comma-separated.
TP_FORGE_TOKEN=
TP_FORGE_ORG=
TP_FORGE_SERVERS=
